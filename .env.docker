# Environment for `docker compose up`. Nothing here is a secret: the stack
# runs a seeded synthetic demo on a local database. Copy real values in only
# if you want the optional integrations.

# Session signing key for the local stack (rotate if you ever expose it).
BETTER_AUTH_SECRET=local-compose-secret-change-me-0123456789abcdef

# Shared secret between you and the agent service HTTP API.
AGENT_SERVICE_TOKEN=dev-agent-token

# ── Optional: an LLM for the Shams chat surfaces and the agent ────────────
# Any OpenAI-compatible endpoint. Ollama on the host works out of the box:
#   ollama pull qwen2.5:14b   (then leave these as they are)
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:14b
# Or AWS Bedrock (takes precedence for the agent when set):
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=eu-west-1
# BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b

# ── Optional: outbound email (invites, magic links, scheduled reports) ────
# RESEND_API_KEY=

# ── Optional: billing ────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=

# ── Optional: LangSmith tracing for the agent ────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
