# Demo - included in repo but blocked in production via middleware

# Large data files (keep small JSON summaries, exclude bulk analysis outputs)
public/data/digitaltwin/**/residuals_*.csv
public/data/digitaltwin/**/*_heatmap*.json
# per_inverter/: track ONLY the two served JSONs (history-capped, <~1 MB) —
# without them the sr-estimate route 404s in every fresh deploy. Bulk CSV
# side-outputs stay ignored.
public/data/soiling/*/per_inverter/*
!public/data/soiling/*/per_inverter/*_per_inverter_sr.json
!public/data/soiling/*/per_inverter/all_inverters.json
public/data/soiling/*/time_series/
public/data/soiling/*/transfer_features.json
public/data/soiling/*/cams_aod_history.json
public/data/prices/_raw/

