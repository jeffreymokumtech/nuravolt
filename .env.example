#MAKE

MAKE_ORGANIZATION_ID=
MAKE_TEAM_ID=
MAKE_API_KEY=
MAKE_API_URL=

#N8N
N8N_API_KEY=
N8N_API_URL=
N8N_WEBHOOK_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DBNAME=postgres
DATABASE_HOST=
DATABASE_PORT=5432

#DB PRISMA (Supabase pooler URL — never commit real credentials)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Stripe keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price ids for the Business tier bands (monthly, EUR).
# Each Price must carry metadata mw_cap = 2 / 8 / 20 respectively.
STRIPE_PRICE_BUSINESS_S_MONTHLY=
STRIPE_PRICE_BUSINESS_M_MONTHLY=
STRIPE_PRICE_BUSINESS_L_MONTHLY=

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical origin of this deployment (prod: https://nuravolt.com)
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Google Cloud Console → Credentials). Optional in dev;
# without it, email/password + magic link still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your app's base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical site origin, used for OG images and auth trusted origins
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog analytics (EU cloud)
NEXT_PUBLIC_POSTHOG_KEY=

# Set to "1" in production to enable the Lemlist visitor tracker. Off in dev to avoid CSP noise.
NEXT_PUBLIC_ENABLE_LEMLIST_TRACKER=

#Resend
RESEND_API_KEY=

#HubSpot (for lead capture)
HUBSPOT_API_KEY=

#WordPress
WORDPRESS_DB_USER=user
WORDPRESS_DB_PASSWORD=
WORDPRESS_DB_NAME=exampledb
WP_REST_ENDPOINT=

#MySQL for WordPress
MYSQL_DATABASE=wp_db
MYSQL_USER=admin
MYSQL_PASSWORD=adminpass
MYSQL_RANDOM_ROOT_PASSWORD='1'
# ── AWS (all EU — see docs/DATA_ARCHITECTURE_GUIDE.md) ───────────────────────
# Single region for the whole AWS stack: S3 lake, Bedrock, SecretsManager, KMS.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock LLM — Qwen on eu-west-1 (best enabled model on the account; DeepSeek
# isn't offered in eu-west-1, and Claude needs the Anthropic use-case form).
# qwen.qwen3-vl-235b-a22b = max quality; qwen.qwen3-32b-v1:0 = smaller/cheaper.
# Python paths also honor BEDROCK_FAULT_MODEL_ID (falls back to this default).
BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b

# ── Iceberg lakehouse (Phase 1+) ────────────────────────────────────────────
LAKE_ENV=dev                 # dev = local ./lake filesystem catalog (no AWS)
LAKE_BUCKET=nuravolt-lake     # S3 warehouse bucket (eu-west-1), used when LAKE_ENV!=dev
# LAKE_WAREHOUSE=./lake       # override local dev warehouse dir

# ── Analytics pipeline (GitHub Actions dispatch) ────────────────────────────
# Fine-grained PAT with Actions read/write on this repo; used by
# src/lib/analytics/trigger-onboarding.ts to dispatch plant-onboarding.yml.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=jeffreymokumtech/nuravolt

# ── Cron + ingest security ──────────────────────────────────────────────────
# Bearer token for /api/cron/* routes (send-reports, poll-connections).
# Also set as the CRON_SECRET GitHub Actions secret for scheduled workflows.
CRON_SECRET=
# Shared key for POST /api/measurements/ingest (x-api-key header).
# If unset, the ingest endpoint is disabled (503) — fail closed.
INGEST_API_KEY=

# Internal service secret for AI tool-layer fetches (generate: openssl rand -hex 24)
INTERNAL_API_SECRET=

# ── Cloud inverter API test credentials (live tests only) ───────────────────
# Consumed by `npm run test:live` (tests/integration/*). All optional: each
# vendor's live test SKIPS when its keys are absent. Never used in default CI.
# Full landscape + how to obtain each: docs/CLOUD_INVERTER_APIS.md.
#
# SolarEdge — a Site or Account API key from a site you own/manage (monitoring
# portal → Admin → Site Access). The `L4QLV…` key in SolarEdge's docs is a dead
# placeholder — do not use it. SITE_ID optional (only for site-scoped keys).
SOLAREDGE_TEST_API_KEY=
SOLAREDGE_TEST_SITE_ID=
# Huawei FusionSolar — a NorthBound account (installer/O&M portal → Company
# Management → Northbound Management). systemCode = the northbound password.
# BASE_URL must match your account region (e.g. https://eu5.fusionsolar.huawei.com).
HUAWEI_TEST_USERNAME=
HUAWEI_TEST_SYSTEM_CODE=
HUAWEI_TEST_BASE_URL=
# Fronius Solar.web Query API — free demo key (register as a business partner;
# Fronius issues a demo key against its example systems). Swagger: api.solarweb.com/swqapi.
FRONIUS_SWQAPI_ACCESSKEY_ID=
FRONIUS_SWQAPI_ACCESSKEY_VALUE=
# GoodWe SEMS (unofficial) — any real SEMS login. The public demo (demo@goodwe.com)
# is currently disabled by GoodWe, so leave blank to soft-skip, or supply a real one.
GOODWE_TEST_ACCOUNT=
GOODWE_TEST_PWD=

# Headless WordPress behind /blog (optional)
WP_BASE_URL=
