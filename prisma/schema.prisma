generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscription {
  id                 String             @id @default(uuid())
  user_email         String             @unique
  sub_status         SubscriptionStatus @default(inactive)
  sub_type           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  last_stripe_cs_id  String             @unique
  stripe_customer_id String             @unique
  sub_stripe_id      String?
  user_clerk_id      String             @unique
  /// Better Auth organization id — billing is per-org, one subscription each.
  org_id               String?   @unique
  /// 'residential' | 'business' (legacy: 'growth') | 'enterprise'
  plan_id              String    @default("residential")
  stripe_price_id      String?
  current_period_end   DateTime?
  cancel_at_period_end Boolean   @default(false)
  /// Seats purchased (Stripe line-item quantity).
  quantity             Int       @default(1)
  /// Purchased business band's MW cap (from Stripe price metadata mw_cap).
  mw_cap               Decimal?  @db.Decimal(10, 3)
}

model Project {
  id            String  @id @default(uuid())
  connection_id String
  webhook_id    String
  scenario_id   String
  assistant_id  String?
  user_clerk_id String
  type          String
  status        String  @default("default")

  webhookLink String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Audiences {
  id        String @id @default(uuid())
  resend_id String @unique
  name      String
}

enum SubscriptionStatus {
  active
  inactive
  trialing
  past_due
  canceled
  unpaid
}

model Lead {
  id                   String   @id @default(uuid())
  email                String   @unique
  name                 String?
  company_name         String?
  role                 String?
  region               String?
  plant_capacity_mw    Decimal? @db.Decimal(10, 2)
  utm_source           String?
  utm_medium           String?
  utm_campaign         String?
  utm_content          String?
  roi_calculation      Json?
  hubspot_contact_id   String?  @unique
  linkedin_campaign_id String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  conversion_events  ConversionEvent[]
  resource_downloads ResourceDownload[]
}

model ABVariant {
  id                 String   @id @default(uuid())
  test_name          String
  variant_name       String
  is_active          Boolean  @default(true)
  traffic_percentage Int      @default(50)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([test_name, variant_name])
}

model ConversionEvent {
  id         String   @id @default(uuid())
  lead_id    String
  event_type String
  event_data Json?
  created_at DateTime @default(now())

  lead Lead @relation(fields: [lead_id], references: [id])

  @@index([lead_id])
  @@index([event_type])
}

model ResourceDownload {
  id             String   @id @default(uuid())
  lead_id        String
  resource_slug  String
  resource_type  String
  resource_title String?
  downloaded_at  DateTime @default(now())
  utm_params     Json?
  ip_address     String?
  user_agent     String?

  lead Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
  @@index([resource_slug])
  @@index([resource_type])
  @@index([downloaded_at])
}

// Data Source Integration Models
model DataConnection {
  id                    String           @id @default(uuid())
  customer_id           String
  organization_id       String? // Link to organization
  name                  String
  description           String?
  type                  ConnectionType
  status                ConnectionStatus @default(pending)
  config                Json // Encrypted connection details
  secret_arn            String? // AWS Secrets Manager ARN
  kms_key_id            String? // Customer KMS key
  polling_interval      Int              @default(900) // seconds
  last_poll_time        DateTime?
  last_poll_status      String?
  last_error            String?
  data_start_date       DateTime? // First available data
  data_end_date         DateTime? // Last available data
  estimated_data_points BigInt?
  plants_connected      Int              @default(0)
  enabled               Boolean          @default(true)
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  field_mappings     FieldMapping[]
  polling_jobs       PollingJob[]
  discovered_plants  DiscoveredPlant[]
  audit_logs         ConnectionAudit[]
  organization       Organization?          @relation(fields: [organization_id], references: [id])
  structure_analysis DataStructureAnalysis?
  generated_configs  GeneratedPlantConfig[]
  plant_data_sources PlantDataSource[]
  latest_snapshots   LatestDeviceSnapshot[]

  @@index([customer_id])
  @@index([organization_id])
  @@index([type])
  @@index([status])
  @@index([last_poll_time])
}

model FieldMapping {
  id               String        @id @default(uuid())
  connection_id    String
  original_field   String
  mapped_field     DataFieldType
  field_path       String? // JSON path or table.column
  unit             String?
  scaling_factor   Decimal       @default(1.0) @db.Decimal(10, 6)
  offset           Decimal       @default(0.0) @db.Decimal(10, 6)
  validation_rules Json?
  confidence_score Decimal?      @db.Decimal(3, 2) // 0.00 to 1.00
  is_confirmed     Boolean       @default(false)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  connection DataConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, original_field])
  @@index([connection_id])
  @@index([mapped_field])
}

model PollingJob {
  id                String    @id @default(uuid())
  connection_id     String
  started_at        DateTime  @default(now())
  completed_at      DateTime?
  status            String // 'running', 'completed', 'failed'
  records_fetched   Int?
  records_processed Int?
  bytes_processed   BigInt?
  error_message     String?
  execution_time_ms Int?
  created_at        DateTime  @default(now())

  connection DataConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@index([connection_id])
  @@index([started_at])
  @@index([status])
}

model DiscoveredPlant {
  id                   String    @id @default(uuid())
  connection_id        String
  external_plant_id    String // Plant ID in source system
  name                 String?
  location             Json? // {lat, lng, country, region}
  capacity_mw          Decimal?  @db.Decimal(8, 3)
  inverter_count       Int?
  inverter_types       String[] // Array of inverter models
  commissioning_date   DateTime? @db.Date
  timezone             String?
  metadata             Json? // Additional plant info
  first_data_timestamp DateTime?
  last_data_timestamp  DateTime?
  enabled              Boolean   @default(true)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  // Multi-asset support
  asset_type AssetType @default(PV)

  connection DataConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, external_plant_id])
  @@index([connection_id])
  @@index([external_plant_id])
  @@index([asset_type])
}

// Latest realtime KPI snapshot per (connection, device). Written by the
// cloud-connector poll path (Huawei FusionSolar today) so dashboards can show
// live device state without scanning the S3 lake. One row per device,
// overwritten each poll.
model LatestDeviceSnapshot {
  id               String   @id @default(uuid())
  connection_id    String
  plant_ext_id     String
  device_ext_id    String
  device_type      String?
  ts               DateTime
  active_power_kw  Float?
  daily_energy_kwh Float?
  extra            Json? // remaining metrics, keyed by DataFieldType name
  updated_at       DateTime @updatedAt

  connection DataConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, device_ext_id])
  @@index([connection_id])
  @@index([plant_ext_id])
}

model ConnectionAudit {
  id            String   @id @default(uuid())
  connection_id String
  action        String // 'created', 'updated', 'tested', 'deleted', 'polled'
  user_id       String? // Clerk user ID
  ip_address    String?
  user_agent    String?
  old_values    Json?
  new_values    Json?
  success       Boolean
  error_message String?
  timestamp     DateTime @default(now())

  connection DataConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@index([connection_id])
  @@index([timestamp])
  @@index([user_id])
}

// ── Data Quality persistence (Wave 3) ──────────────────────────────────
// Denormalised stream health snapshots + operator overrides (ACK,
// exclusions) and long-running incident grouping for the DQ Hub.
// Models follow the schema-wide multi-tenant convention: every customer
// row carries `org_clerk_id` and is indexed on it. No FK relations to
// Plant — consistent with DataConnection / Ticket / PlantAccess.

model DataStreamHealth {
  id                    String    @id @default(uuid())
  org_clerk_id          String
  plant_id              String
  stream_id             String
  label                 String?
  // inverter | met_sensor | soiling_sensor | scada | other
  category              String
  // low | medium | high | normal
  severity              String
  last_good_at          DateTime?
  last_value            Float?
  gap_minutes           Int       @default(0)
  // network_outage | sensor_drift | inverter_trip | met_station_shadow |
  // dustiq_firmware_quirk | unknown
  attribution_cause     String?
  attribution_narrative String?
  // KPIs whose computation is affected by this stream (PR | SR | AC_yield | …)
  affected_kpis         String[]  @default([])
  updated_at            DateTime  @updatedAt

  @@unique([org_clerk_id, plant_id, stream_id])
  @@index([plant_id, severity])
  @@index([org_clerk_id, plant_id])
}

model DataQualityAcknowledgement {
  id              String    @id @default(uuid())
  org_clerk_id    String
  plant_id        String
  stream_id       String
  // Clerk user id or 'AM' for the asset-manager demo principal
  acknowledged_by String
  acknowledged_at DateTime  @default(now())
  reason          String?
  expires_at      DateTime?
  incident_id     String?

  @@index([org_clerk_id, plant_id, stream_id])
  @@index([acknowledged_at])
}

model DataStreamExclusion {
  id           String    @id @default(uuid())
  org_clerk_id String
  plant_id     String
  stream_id    String
  // KPI names to exclude this stream from (PR | SR | AC_yield | …).
  // Empty array = exclude from ALL KPI rollups.
  kpi_names    String[]  @default([])
  starts_at    DateTime  @default(now())
  // null = open-ended exclusion
  ends_at      DateTime?
  created_by   String
  reason       String?
  incident_id  String?

  @@index([org_clerk_id, plant_id, stream_id])
  @@index([starts_at, ends_at])
}

model DataQualityIncident {
  id           String    @id @default(uuid())
  org_clerk_id String
  plant_id     String
  opened_at    DateTime  @default(now())
  closed_at    DateTime?
  summary      String
  // low | medium | high
  severity     String
  ticket_id    String?
  opened_by    String

  @@index([org_clerk_id, plant_id, opened_at])
}

// Connection templates for common SCADA vendors
model ConnectionTemplate {
  id              String         @id @default(uuid())
  name            String         @unique // "SMA Sunny Portal", "Huawei FusionSolar"
  vendor          String // "SMA", "Huawei", "Fronius"
  connection_type ConnectionType
  description     String?

  // Auto-detection patterns
  field_patterns     Json // [{regex, fieldType, confidence, unit}]
  inverter_patterns  Json? // Regex patterns for inverter ID extraction
  timestamp_formats  String[] // Common timestamp formats for this system
  component_patterns Json? // How to extract plant/inverter hierarchy

  // Template configuration
  config_schema Json? // JSON Schema for connection config form

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([vendor])
  @@index([connection_type])
}

// Analyzed data structure from discovery
model DataStructureAnalysis {
  id            String @id @default(uuid())
  connection_id String @unique

  // Format detection
  data_format      String // 'wide', 'long', 'mixed'
  timestamp_format String? // Detected timestamp format (strptime)
  timestamp_column String? // Detected timestamp column name

  // Column analysis
  total_columns    Int
  numeric_columns  Int
  string_columns   Int
  datetime_columns Int

  // Component detection
  detected_plants    Json? // Array of detected plant IDs
  detected_inverters Json? // Array of detected inverter patterns
  hierarchy_pattern  String? // e.g., "Plant: {plant} / INV {inv} / {field}"

  // Sample data for preview
  sample_data       Json? // First 10 rows for UI preview
  column_statistics Json? // Min/max/mean/nulls per column

  analyzed_at DateTime @default(now())

  connection DataConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@index([connection_id])
}

// Generated Python PlantConfig for analytics integration
model GeneratedPlantConfig {
  id            String @id @default(uuid())
  connection_id String
  plant_id      String // External plant ID from DiscoveredPlant

  // The generated config
  config_json Json // PlantConfig as JSON
  config_yaml String @db.Text // PlantConfig as YAML for Python

  // Versioning
  version   Int     @default(1)
  is_active Boolean @default(true)

  // Validation
  validation_status String    @default("pending") // pending, valid, invalid
  validation_errors Json? // Array of validation error messages
  validated_at      DateTime?

  // Timestamps
  generated_at DateTime @default(now())
  updated_at   DateTime @updatedAt

  connection DataConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, plant_id, version])
  @@index([connection_id])
  @@index([plant_id])
  @@index([is_active])
}

enum ConnectionType {
  influxdb
  sql_scada
  modbus_tcp
  csv_upload
  huawei_api
  sungrow_api
  solaredge_api
  sample_api
}

enum ConnectionStatus {
  pending
  connecting
  connected
  error
  disabled
}

