{
	"name": "nuravolt",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "cross-env NODE_OPTIONS='--max-http-header-size=32768 --max-old-space-size=8192' node server.js",
		"dev:next": "cross-env HOST=127.0.0.1 next dev -p 3000 -H 127.0.0.1",
		"build": "npx prisma generate && next build",
		"start": "next start",
		"lint": "next lint && bash scripts/check-marketing-consistency.sh",
		"test": "vitest run tests/api/bess-audit-route.test.ts tests/api/bess-revenue-lanes.test.ts tests/api/billing-capacity.test.ts tests/api/contract-availability.test.ts tests/api/contract-intelligence.test.ts tests/api/demo-threads.test.ts tests/alerts tests/connectors tests/db && vitest run --config tests/ui/vitest.config.ts",
		"test:py:ci": "pytest -q tests/fault tests/soiling tests/bess tests/validation tests/twin tests/markets tests/lake tests/agent --ignore=tests/soiling/test_served_artifacts.py",
		"test:py:agent": "pytest -q tests/agent",
		"check-consistency": "bash scripts/check-marketing-consistency.sh",
		"migrate-db": "npx prisma migrate dev --name init",
		"seed": "npx ts-node prisma/seed.ts",
		"seed:demo": "tsx prisma/seed-demo-account.ts",
		"seed:local-demo": "bash scripts/seed_local_demo.sh",
		"seed:manuals": "npx tsx scripts/seed_manuals.ts",
		"seed:standalone-bess": "npx tsx scripts/seed_standalone_bess.ts",
		"generate-pdfs": "node scripts/generate-pdfs.js",
		"setup-hubspot": "node scripts/setup-hubspot-properties.js",
		"test:api": "vitest run tests/api tests/connectors",
		"test:py": "pytest -q tests",
		"test:connectors": "vitest run tests/connectors",
		"test:live": "vitest run tests/integration",
		"qa:collect": "python3 -m automation.qa.collect",
		"qa:api": "python3 -m automation.qa.collect --cases automation/qa/cases/api-full.yaml",
		"qa:ui": "python3 -m automation.qa.collect --cases automation/qa/cases/dashboard-walk.yaml",
		"qa:leaks": "python3 scripts/check_dashboard_leaks.py",
		"validate": "bash automation/qa/validate.sh"
	},
	"engines": {
		"node": "22.x",
		"npm": ">=8.0.0"
	},
	"prisma": {
		"seed": "ts-node prisma/seed.ts"
	},
